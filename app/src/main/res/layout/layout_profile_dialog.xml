<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/dialogBackgroundContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aozora Tuning"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/btnPowerSave"
                android:layout_width="wrap_content"
                android:minWidth="60dp"
                android:layout_height="56dp"
                android:paddingHorizontal="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/icPowerSave"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_battery_saver" />
                <TextView
                    android:id="@+id/tvPowerSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PowerSave"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnBalance"
                android:layout_width="wrap_content"
                android:minWidth="60dp"
                android:layout_height="56dp"
                android:paddingHorizontal="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/icBalance"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_balance" />
                <TextView
                    android:id="@+id/tvBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Balance"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnGaming"
                android:layout_width="wrap_content"
                android:minWidth="60dp"
                android:layout_height="56dp"
                android:paddingHorizontal="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/icGaming"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_gaming" />
                <TextView
                    android:id="@+id/tvGaming"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gaming"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/btnGaming2"
                android:layout_width="wrap_content"
                android:minWidth="60dp"
                android:layout_height="56dp"
                android:paddingHorizontal="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/icGaming2"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_gaming2" />
                <TextView
                    android:id="@+id/tvGaming2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gaming 2"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPerformance"
                android:layout_width="wrap_content"
                android:minWidth="60dp"
                android:layout_height="56dp"
                android:paddingHorizontal="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/icPerformance"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_performance" />
                <TextView
                    android:id="@+id/tvPerformance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Performance"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
